# Copy to .env and fill in. Never commit .env.

# Base domain served by Caddy. Services live at <name>.${HOMELAB_DOMAIN}
HOMELAB_DOMAIN=home.lan

# LAN IP of the homelab host
HOMELAB_IP=192.168.1.10

# Where all persistent service data lives (the only path backups need)
DATA_DIR=/srv/homelab

TZ=Asia/Jerusalem
PUID=1000
PGID=1000

# Beszel: the agent key is shown in the Beszel UI when you add a system
BESZEL_AGENT_KEY=

# Diun notifications (ntfy example). Leave blank to log only.
DIUN_NTFY_ENDPOINT=https://ntfy.sh
DIUN_NTFY_TOPIC=

# restic backups (used by scripts/backup.sh)
RESTIC_REPOSITORY=/mnt/backup/restic
RESTIC_PASSWORD_FILE=/root/.restic-password
